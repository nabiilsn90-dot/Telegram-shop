# === TELEGRAM CONFIGURATION ===
TOKEN=your_bot_token_here
OWNER_ID=123456789

# === PAYMENT CONFIGURATION ===
TELEGRAM_PROVIDER_TOKEN=
CRYPTO_PAY_TOKEN=

# Price of 1 unit of your currency in stars (0 to disable)
STARS_PER_VALUE=0.91

# Currency for payments (أو جعلها مخصصة للنقاط PTS)
PAY_CURRENCY=USD

# Referral system percentage (0-100, 0 to disable)
REFERRAL_PERCENT=0

# Payment timeout in seconds
PAYMENT_TIME=1800

# === تم إلغاء الحدود الدنيا والعليا للشحن بالسماح بمبالغ صغيرة جداً (مثل 10 سنتيم = 10 نقاط) ===
MIN_AMOUNT=0.01
MAX_AMOUNT=100000

# === LINKS & UI CONFIGURATION ===
CHANNEL_URL=
CHANNEL_ID=
HELPER_ID=
RULES="1. Be respectful\n2. No spam\n3. Follow Telegram ToS"

# === LOCALIZATION & LOGGING ===
BOT_LOCALE=ru
BOT_LOGFILE=logs/bot.log
BOT_AUDITFILE=logs/audit.log
LOG_TO_STDOUT=1
LOG_TO_FILE=1
DEBUG=0
REVIEWS_ENABLED=1

# === REDIS CONFIGURATION ===
REDIS_ENABLED=1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme_redis_pass

# === DATABASE CONFIGURATION ===
POSTGRES_DB=telegram_shop
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_HOST=localhost
DB_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# === WEB ADMIN PANEL ===
ADMIN_HOST=localhost
ADMIN_PORT=9090
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SECRET_KEY=change-me-in-production
ADMIN_COOKIE_SECURE=auto

# === WEBHOOK MODE ===
WEBHOOK_ENABLED=0
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# === AUTO-CLEANUP ===
AUDIT_RETENTION_DAYS=90
PAYMENTS_RETENTION_DAYS=90
