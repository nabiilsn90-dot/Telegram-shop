# === TELEGRAM CONFIGURATION ===
TOKEN=your_bot_token_here
OWNER_ID=123456789

# === PAYMENT CONFIGURATION & NEW GATEWAYS ===
# Telegram Payments provider token (optional)
TELEGRAM_PROVIDER_TOKEN=

# CryptoPay API token (optional)
CRYPTO_PAY_TOKEN=

# Cryptomus API & Merchant details (لربط منصة Cryptomus)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# Binance / Cwallet / FaucetPay / Coinex keys (متغيرات مخصصة لربط المنصات الجديدة)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
CWALLET_API_TOKEN=
FAUCETPAY_API_KEY=
COINEX_API_KEY=

# Telegram Stars configuration
STARS_PER_VALUE=0.91

# Currency for payments (ثبتناها على الدولار لحساب النقاط بدقة: 1 دولار = 100 نقطة)
PAY_CURRENCY=USD

# Referral system percentage (0-100, 0 to disable)
REFERRAL_PERCENT=0

# Payment timeout in seconds
PAYMENT_TIME=1800

# Payment limits (تم إلغاء القيود للسماح بشحن المبالغ الصغيرة مثل 10 سنت = 10 نقاط)
MIN_AMOUNT=0.01
MAX_AMOUNT=100000

# === LINKS & UI CONFIGURATION ===
CHANNEL_URL=
CHANNEL_ID=
HELPER_ID=
RULES="1. Be respectful\n2. No spam\n3. Follow Telegram ToS"

# === LOCALIZATION & LOGGING ===
BOT_LOCALE=ru
BOT_LOGFILE=logs/bot.log
BOT_AUDITFILE=logs/audit.log
LOG_TO_STDOUT=1
LOG_TO_FILE=1
DEBUG=0
REVIEWS_ENABLED=1

# === REDIS CONFIGURATION ===
REDIS_ENABLED=1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme_redis_pass

# === DATABASE CONFIGURATION ===
POSTGRES_DB=telegram_shop
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_HOST=localhost
DB_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# === WEB ADMIN PANEL ===
ADMIN_HOST=localhost
ADMIN_PORT=9090
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SECRET_KEY=change-me-in-production
ADMIN_COOKIE_SECURE=auto

# === WEBHOOK MODE ===
WEBHOOK_ENABLED=0
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# === AUTO-CLEANUP ===
AUDIT_RETENTION_DAYS=90
PAYMENTS_RETENTION_DAYS=90
